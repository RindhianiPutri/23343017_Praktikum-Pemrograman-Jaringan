<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{judul}}</title>
  <style>
    body {
      font-family: 'Poppins', sans-serif;
      background: #f2f8f9;
      margin: 0;
      padding: 0;
    }

    header {
      text-align: center;
      background-color: #106466;
      color: white;
      padding: 20px 0;
      border-bottom: 5px solid #7FC8A9;
    }

    nav a {
      margin: 0 10px;
      color: white;
      text-decoration: none;
      font-weight: 500;
      transition: color 0.3s;
    }

    nav a:hover {
      color: #FFD700;
    }

    .container {
      max-width: 900px;
      margin: 60px auto;
      background: #ffffff;
      padding: 40px;
      border-radius: 12px;
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }

    h1 {
      text-align: center;
      color: #106466;
      margin-bottom: 10px;
      font-size: 28px;
    }

    p.desc {
      text-align: center;
      color: #555;
      margin-bottom: 30px;
      font-size: 15px;
    }

    .search-box {
      display: flex;
      justify-content: center;
      margin-bottom: 30px;
    }

    input[type="text"] {
      width: 65%;
      padding: 10px 15px;
      border-radius: 25px;
      border: 1px solid #ccc;
      outline: none;
      font-size: 14px;
      transition: 0.2s;
    }

    input[type="text"]:focus {
      border-color: #106466;
      box-shadow: 0 0 5px rgba(16, 100, 102, 0.4);
    }

    button {
      background-color: #106466;
      color: white;
      padding: 10px 18px;
      border: none;
      border-radius: 25px;
      margin-left: 10px;
      cursor: pointer;
      font-size: 14px;
      transition: background 0.3s;
    }

    button:hover {
      background-color: #0b4d4f;
    }

    .news-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 20px;
      margin-top: 20px;
    }

    .news-card {
      background-color: #eaf6f6;
      border-radius: 10px;
      padding: 20px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .news-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    }

    .news-card h3 {
      font-size: 16px;
      color: #064663;
      margin-bottom: 10px;
    }

    .news-card p {
      font-size: 14px;
      color: #444;
      margin-bottom: 10px;
    }

    .news-card a {
      text-decoration: none;
      color: #106466;
      font-weight: bold;
      transition: color 0.2s;
    }

    .news-card a:hover {
      color: #0b4d4f;
    }

    .footer {
      text-align: center;
      margin-top: 40px;
      font-size: 14px;
      color: #666;
      border-top: 1px solid #ccc;
      padding-top: 15px;
    }
  </style>
</head>
<body>
  <header>
    <nav>
      <a href="/">Home</a>
      <a href="/tentang">Tentang</a>
      <a href="/bantuan">Bantuan</a>
      <a href="/berita"><b>Berita</b></a>
    </nav>
  </header>

  <div class="container">
    <h1>📰 Berita Terkini</h1>
    <p class="desc">Berita terbaru dari berbagai sumber, disajikan langsung melalui API Mediastack.</p>

    <div class="search-box">
      <input type="text" id="kategori" placeholder="Cari berita (contoh: technology, sports, politics)">
      <button id="btnCari">Cari</button>
    </div>

    <div id="hasil" class="news-list">
      <p style="text-align:center;">Tidak ada berita ditemukan.</p>
    </div>

    <p class="footer">Dikembangkan oleh <b>Rindhiani Putri</b></p>
  </div>

  <script>
    const btnCari = document.getElementById('btnCari');
    const input = document.getElementById('kategori');
    const hasil = document.getElementById('hasil');

    btnCari.addEventListener('click', async () => {
      const kategori = input.value.trim() || 'technology';
      hasil.innerHTML = '<p style="text-align:center;">🔍 Mencari berita...</p>';

      try {
        const res = await fetch(`/berita/data?kategori=${kategori}`);
        const data = await res.json();
        console.log("DATA DARI BACKEND:", data);

        if (data.berita && data.berita.length > 0) {
          hasil.innerHTML = data.berita
            .map(b => `
              <div class="news-card">
                <h3>${b.title}</h3>
                <p>${b.description || ''}</p>
                <a href="${b.url}" target="_blank">Baca Selengkapnya</a>
              </div>
            `)
            .join('');
        } else {
          hasil.innerHTML = '<p style="text-align:center;">❌ Tidak ditemukan berita untuk kategori itu.</p>';
        }
      } catch (error) {
        hasil.innerHTML = '<p style="text-align:center;color:red;">⚠️ Terjadi kesalahan saat mengambil berita.</p>';
        console.error(error);
      }
    });
  </script>
</body>
</html>
